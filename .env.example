# MOA Application Environment Variables Template
# Copy this file to .env for local development

# --- Spring Boot Backend Configuration ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database Settings (PostgreSQL / MySQL / H2)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moa_db
DB_USERNAME=moa_user
DB_PASSWORD=

# Firebase Admin SDK (Google/Apple 로그인 검증용)
# 아직 Firebase 프로젝트가 없다면 비워둔다 - 이 값이 비어있으면 POST /auth/login만
# 503(FIREBASE_NOT_CONFIGURED)으로 응답하고 나머지 API는 정상 동작한다.
# 설정 방법: backend/README.md의 'Firebase 프로젝트 설정' 참고.
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=

# Security & JWT
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Redis Cache & Session
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Flutter Frontend Configuration ---
FLUTTER_APP_TITLE=MOA
FLUTTER_API_BASE_URL=http://localhost:8080/api/v1
ENABLE_MOCK_DATA=false
