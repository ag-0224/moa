# MOA Application Environment Variables Template
# Copy this file to .env for local development

# --- Spring Boot Backend Configuration ---
SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080

# Database Settings (PostgreSQL / MySQL / H2)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=moa_db
DB_USERNAME=moa_user
DB_PASSWORD=

# Security & JWT
JWT_SECRET=
JWT_EXPIRATION_MS=86400000

# Redis Cache & Session
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Flutter Frontend Configuration ---
FLUTTER_APP_TITLE=MOA
FLUTTER_API_BASE_URL=http://localhost:8080/api/v1
ENABLE_MOCK_DATA=false
